<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit - <%= student.name %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="zen-shell" style="max-width: 480px;">
        <div class="zen-header">
            <h1>Edit <%= student.name %>
            </h1>
            <a href="/" class="zen-link-btn">&larr; Return</a>
        </div>

        <form action="/<%= student._id %>" method="POST" class="form-grid">
            <div class="form-field">
                <label>Student Name</label>
                <input name="name" value="<%= student.name %>" required />
            </div>

            <div class="form-field">
                <label>Age</label>
                <input name="age" type="number" value="<%= student.age %>" required />
            </div>

            <div class="form-field">
                <label>Course</label>
                <input name="course" value="<%= student.course %>" required />
            </div>

            <div class="form-field">
                <label>Email</label>
                <input name="email" type="email" value="<%= student.email %>" required />
            </div>

            <button type="submit" class="btn-vermilion-submit">Update Record</button>
        </form>
    </div>
</body>

</html>